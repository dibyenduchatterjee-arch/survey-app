# Copy to .env and fill in. Only this example file is ever committed.

# SQLAlchemy URL for the database (blank = default local SQLite file)
DATABASE_URL=
# Secret used to sign login tokens. Required; no default; at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Key used to encrypt media at rest. Required; no default.
MEDIA_KEY=
# Directory where uploaded media is stored (blank = server/media)
MEDIA_ROOT=
# Extra allowed browser origins: blank for none, comma-separated (a,b,c), or a JSON list
CORS_ORIGINS=
# Set to true when a reverse proxy (Caddy, nginx) sits in front of the app. Without it every
# client appears to come from the proxy's address and all users share ONE login rate-limit
# bucket. Leave false when clients connect directly: X-Forwarded-For is client-controlled.
TRUST_PROXY_HEADERS=false
# How many trusted proxies append to X-Forwarded-For (1 for a single Caddy or nginx).
TRUSTED_PROXY_HOPS=1

# Google exports. Path to the service-account JSON key (keep it outside the repo; never commit it).
GOOGLE_SERVICE_ACCOUNT_FILE=
# Drive folder id the CSVs go to (the part after /folders/ in its URL). Share the folder with the
# service account client_email as Editor.
DRIVE_FOLDER_ID=
# Optional: Google Sheet id refreshed with the main CSV (also shared with the service account).
GOOGLE_SHEET_ID=
