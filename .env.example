# Copy to .env and fill in. Only this example file is ever committed.

# SQLAlchemy URL for the database (blank = default local SQLite file)
DATABASE_URL=
# Secret used to sign login tokens. Required; no default. Use a long random string.
JWT_SECRET=
# Key used to encrypt media at rest. Required; no default.
MEDIA_KEY=
# Directory where uploaded media is stored (blank = server/media)
MEDIA_ROOT=
# Extra allowed browser origins: blank for none, comma-separated (a,b,c), or a JSON list
CORS_ORIGINS=
