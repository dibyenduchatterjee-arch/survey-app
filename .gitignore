# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
credentials*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# data — never commit field data
*.db
*.sqlite
*.sqlite3
server/media/
server/exports/
*.xlsx
!server/tests/fixtures/*.xlsx

# os / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# SDD scratch workspace (ledger, briefs, review packages)
.superpowers/

# webapp/config.js is COMMITTED on purpose: it holds only the Apps Script address, which is not a
# secret (without a valid access code it returns nothing), and GitHub Pages must ship it.
