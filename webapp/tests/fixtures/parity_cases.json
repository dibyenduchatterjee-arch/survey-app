{
 "synth": {
  "form_id": "synth",
  "version": "1",
  "title": {
   "default": "synth"
  },
  "languages": [
   "default"
  ],
  "default_language": "default",
  "choices": {},
  "nodes": [
   {
    "type": "calculate",
    "name": "a",
    "calculate": "${b} + 1"
   },
   {
    "type": "calculate",
    "name": "b",
    "calculate": "${x} * 2"
   },
   {
    "type": "integer",
    "name": "x",
    "label": {
     "default": "x"
    }
   },
   {
    "type": "select_one",
    "name": "show_r",
    "label": {
     "default": "show"
    },
    "choices_ref": "yn"
   },
   {
    "type": "group",
    "name": "g",
    "relevant": "${x} > 5",
    "children": [
     {
      "type": "calculate",
      "name": "gc",
      "calculate": "${x} + 100"
     },
     {
      "type": "integer",
      "name": "gq",
      "label": {
       "default": "gq"
      },
      "required": true
     }
    ]
   },
   {
    "type": "calculate",
    "name": "gate",
    "calculate": "if(${x} > 5, 'open', 'shut')"
   },
   {
    "type": "group",
    "name": "h",
    "relevant": "${gate} = 'open'",
    "children": [
     {
      "type": "calculate",
      "name": "hc",
      "calculate": "1"
     },
     {
      "type": "integer",
      "name": "hq",
      "label": {
       "default": "hq"
      },
      "required": true
     }
    ]
   },
   {
    "type": "repeat",
    "name": "r",
    "relevant": "${show_r} = 'yes'",
    "children": [
     {
      "type": "integer",
      "name": "rv",
      "label": {
       "default": "rv"
      },
      "constraint": ". < 10",
      "constraint_message": {
       "default": "rv under ten"
      }
     },
     {
      "type": "calculate",
      "name": "rc",
      "calculate": "${rv} * 2"
     },
     {
      "type": "calculate",
      "name": "rn",
      "calculate": "position()"
     },
     {
      "type": "repeat",
      "name": "rr",
      "children": [
       {
        "type": "integer",
        "name": "rrv",
        "label": {
         "default": "rrv"
        },
        "required": true
       },
       {
        "type": "calculate",
        "name": "rrc",
        "calculate": "${rrv} + ${rv}"
       }
      ]
     }
    ]
   },
   {
    "type": "calculate",
    "name": "rsum",
    "calculate": "sum(${rv})"
   },
   {
    "type": "calculate",
    "name": "rcount",
    "calculate": "count(${rv})"
   },
   {
    "type": "integer",
    "name": "e1",
    "label": {
     "default": "e1"
    },
    "relevant": "${x} | 1",
    "required": true
   },
   {
    "type": "integer",
    "name": "e2",
    "label": {
     "default": "e2"
    },
    "constraint": "${x} | 1"
   },
   {
    "type": "calculate",
    "name": "e3",
    "calculate": "${x} | 1"
   },
   {
    "type": "select_multiple",
    "name": "sm",
    "label": {
     "default": "sm"
    },
    "choices_ref": "yn"
   },
   {
    "type": "text",
    "name": "sm_note",
    "label": {
     "default": "n"
    },
    "relevant": "selected(${sm}, 'no')",
    "required": true
   }
  ]
 },
