    "calculate": "today() - ${start}"
   },
   {
    "type": "repeat",
    "name": "A",
    "relevant": "${gate} != 'open'",
    "children": [
     {
      "type": "integer",
      "name": "v",
      "label": {
       "default": "v"
      },
      "required": true
     },
     {
      "type": "calculate",
      "name": "ac",
      "calculate": "${v} * 2"
     },
     {
      "type": "repeat",
      "name": "B",
      "relevant": "${v} > 1",
      "children": [
       {
        "type": "integer",
        "name": "w",
        "label": {
         "default": "w"
        },
        "required": true
       },
       {
        "type": "calculate",
        "name": "bc",
        "calculate": "${w} + ${v}"
       },
       {
        "type": "repeat",
        "name": "C",
        "children": [
         {
          "type": "integer",
          "name": "u",
          "label": {
           "default": "u"
          },
          "required": true,
          "constraint": ". < 100"
         },
         {
          "type": "calculate",
          "name": "cc",
          "calculate": "${u} * 3 + ${w}"
         },
         {
          "type": "calculate",
          "name": "cn",
          "calculate": "position()"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "calculate",
    "name": "gate",
    "calculate": "if(${x} > 5, 'open', 'shut')"
   },
   {
    "type": "calculate",
    "name": "total_u",
    "calculate": "sum(${u})"
   },
   {
    "type": "calculate",
    "name": "n_w",
    "calculate": "count(${w})"
   }
  ]
